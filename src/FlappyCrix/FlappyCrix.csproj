<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build:  dotnet build -c Release -p:GamePath="C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag"
    Needs:  BepInEx 5 installed in the game, and the UnityWebBrowser DLLs collected into
            ..\..\mod\FlappyCrix\ by tools\collect_uwb.ps1 (see README.md).
    Output: FlappyCrix.dll is copied to mod\FlappyCrix\ and, if DeployToGame=true,
            to <GamePath>\BepInEx\plugins\FlappyCrix\.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FlappyCrix</AssemblyName>
    <RootNamespace>FlappyCrix</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GamePath>
    <Managed>$(GamePath)\Gorilla Tag_Data\Managed</Managed>
    <DistDir>$(MSBuildThisFileDirectory)..\..\mod\FlappyCrix</DistDir>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bridge is built into the DLL (always matches it; a DLL-only install still runs the live site) -->
    <EmbeddedResource Include="..\..\mod\FlappyCrix\Web\__flappycrix\bridge.js" LogicalName="FlappyCrix.bridge.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game + BepInEx (never copied into the mod) -->
    <Reference Include="BepInEx"><HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(Managed)\UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(Managed)\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(Managed)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(Managed)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>

    <!-- UnityWebBrowser (shipped next to FlappyCrix.dll, collected by tools\collect_uwb.ps1) -->
    <Reference Include="VoltstroStudios.UnityWebBrowser"><HintPath>$(DistDir)\VoltstroStudios.UnityWebBrowser.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VoltstroStudios.UnityWebBrowser.Shared"><HintPath>$(DistDir)\VoltstroStudios.UnityWebBrowser.Shared.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToDist" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistDir)" />
    <Copy Condition="'$(DeployToGame)' == 'true'" SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\BepInEx\plugins\FlappyCrix" />
  </Target>
</Project>
